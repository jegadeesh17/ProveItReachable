# Copy this file to .env and fill in the values in your own editor. Never commit .env or paste a key into a chat.
# Every setting has a default (shown here) except the secrets and IDs, which are left empty.
# An empty value means "use the default". See "Configuration: environment variables" in docs/ARCHITECTURE.md.

# --- Needed from M1 (scans and eval) ---

# Nebius Token Factory API key (inference and Sandboxes). Console: https://tokenfactory.nebius.com -> API keys.
NEBIUS_API_KEY=
# Nebius project ID, used by the Sandboxes API. Shown in the Token Factory console project settings.
NEBIUS_PROJECT_ID=
# Model ID; must contain "nemotron".
NEBIUS_MODEL=nvidia/nemotron-3-super-120b-a12b
# USD per million input / output tokens (pessimistic, used for metering).
NEBIUS_PRICE_INPUT_PER_MTOK=0.60
NEBIUS_PRICE_OUTPUT_PER_MTOK=2.40
# sandbox (real Sandbox) or fake (local fixtures only).
EXECUTOR=sandbox
# Sandbox base image: <version tag>@sha256:<index digest> (Python 3.13.11, uv 0.9.30). Only the tag is imported; the digest must equal base_image in src/pir/executor/base_image_fingerprint.json. A tag-only value is refused.
SANDBOX_BASE_IMAGE=ghcr.io/astral-sh/uv:0.9.30-python3.13-bookworm-slim@sha256:531f855bda2c73cd6ef67d56b733b357cea384185b3022bd09f05e002cd144ca
# Sandbox cost estimate / fallback rate (USD per second) and concurrent operations (platform limit 50).
SANDBOX_USD_PER_SECOND=0.001
SANDBOX_MAX_CONCURRENT_OPS=4
# Tavily API key for advisory research. Dashboard: https://app.tavily.com
TAVILY_API_KEY=
# Tavily search depth (basic = 1 credit, advanced = 2), results per search, and USD per credit for metering.
TAVILY_SEARCH_DEPTH=basic
TAVILY_MAX_RESULTS=5
TAVILY_PRICE_PER_CREDIT_USD=0.008
# LangSmith API key for traces and the eval dataset. https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=
# true to send traces to LangSmith (needed for eval runs and the hosted demo).
LANGSMITH_TRACING=false
LANGSMITH_PROJECT=ProveItReachable
# LangSmith region endpoint (EU accounts use a different one).
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_DATASET=proveitreachable-eval-v1
# Repository size caps and the Python version used to compile dependency pins.
MAX_REPO_MB=50
MAX_REPO_FILES=5000
MAX_PY_FILE_BYTES=1000000
RESOLVE_PYTHON_VERSION=3.12
# Reasoning bounds and the worst-case token hold when max_completion_tokens is unsupported.
MAX_FINDINGS_REASONED=20
FINDING_CONCURRENCY=4
MAX_TOOL_ROUNDS=8
MAX_MODEL_RETRIES=2
MAX_COMPLETION_TOKENS=1500
LLM_HOLD_COMPLETION_TOKENS=16000
# Call timeouts and the whole-scan deadline, in seconds.
TIMEOUT_GITHUB_S=10
TIMEOUT_OSV_S=15
TIMEOUT_TAVILY_S=20
TIMEOUT_NEBIUS_S=60
SCAN_TIMEOUT_S=900
# Sandbox step and proof timeouts, in seconds.
TIMEOUT_SANDBOX_FETCH_S=120
TIMEOUT_SANDBOX_RESOLVE_S=60
TIMEOUT_SANDBOX_COMPILE_S=180
TIMEOUT_SANDBOX_INDEX_S=120
TIMEOUT_PROOF_INSTALL_S=300
TIMEOUT_PROOF_RUN_S=60
# Hard spend caps in USD (build caps for the file ledger) and the last day of the daily ceiling.
SPEND_CAP_NEBIUS_USD=10
SPEND_CAP_TAVILY_USD=5
SPEND_END_DATE=2026-12-15
# Per-scan reservation in USD and the pause threshold.
SCAN_BUDGET_NEBIUS_USD=0.75
SCAN_BUDGET_TAVILY_USD=0.40
SCAN_MIN_START_USD=0.05
# file (local, before deploy) or hf_dataset (every spender after deploy), and the local ledger file.
SPEND_LEDGER_BACKEND=file
SPEND_LEDGER_PATH=./data/spend_ledger.json
# Recordings, replay pacing, caches and local ledger directory, job retention.
REPLAY_DIR=./demo/replays
REPLAY_MAX_SECONDS=20
DATA_DIR=./data
JOB_TTL_S=3600
MAX_JOBS=200
# Listen port (the Space uses 7860) and JSON log level.
PORT=8000
LOG_LEVEL=INFO
# 1 enables the paid "live" tests (run only at milestone verification). Leave empty otherwise.
PIR_LIVE_TESTS=

# --- Needed from M2 (hosted demo and shared spend ledger) ---

# Optional: GitHub fine-grained token, public repos read-only; lifts the 60 requests/hour limit. github.com -> Settings -> Developer settings.
GITHUB_TOKEN=
# Hugging Face token with write access to the spend-ledger dataset only. huggingface.co -> Settings -> Access Tokens (fine-grained).
HF_TOKEN=
# Private Hugging Face dataset that holds the spend ledger, for example <your-hf-user>/pir-spend-ledger.
SPEND_LEDGER_HF_REPO=
# false = replays only, no keys needed. Which X-Forwarded-For entry is the client (deploy: likely 1).
LIVE_SCANS_ENABLED=true
TRUSTED_PROXY_HOPS=0
# Live-scan limits.
RATE_LIMIT_PER_CLIENT_HOUR=3
RATE_LIMIT_PER_CLIENT_DAY=10
RATE_LIMIT_GLOBAL_DAY=10
MAX_CONCURRENT_SCANS=2
# Replay and stream caps.
MAX_CONCURRENT_REPLAYS=10
MAX_SSE_STREAMS=40
RATE_LIMIT_REPLAYS_PER_CLIENT_HOUR=30
# Cut switches.
FEATURE_PROGRESS_FEED=true
FEATURE_MARKDOWN_EXPORT=true
FEATURE_PROOF=false
