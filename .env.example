# Copy this file to .env and fill in the values in your own editor. Never commit .env or paste a key into a chat.
# Every other setting has a default; see "Configuration: environment variables" in docs/ARCHITECTURE.md.

# --- Needed from M1 (scans and eval) ---

# Nebius Token Factory API key (inference and Sandboxes). Console: https://tokenfactory.nebius.com -> API keys.
NEBIUS_API_KEY=
# Nebius project ID, used by the Sandboxes API. Shown in the Token Factory console project settings.
NEBIUS_PROJECT_ID=
# Optional: Nemotron model ID. Leave empty for the default (nvidia/nemotron-3-super-120b-a12b).
NEBIUS_MODEL=
# Tavily API key for advisory research. Dashboard: https://app.tavily.com
TAVILY_API_KEY=
# LangSmith API key for traces and the eval dataset. https://smith.langchain.com -> Settings -> API Keys
LANGSMITH_API_KEY=
# true to send traces to LangSmith (needed for eval runs). Default: false.
LANGSMITH_TRACING=
# Optional: LangSmith project name. Default: ProveItReachable.
LANGSMITH_PROJECT=
# Optional: LangSmith region endpoint. Default: https://api.smith.langchain.com (EU accounts use a different one).
LANGSMITH_ENDPOINT=
# Optional: 1 enables the paid "live" tests (run only at milestone verification). Default: unset.
PIR_LIVE_TESTS=

# --- Needed from M2 (hosted demo and shared spend ledger) ---

# Optional: GitHub fine-grained token, public repos read-only; lifts the 60 requests/hour limit. github.com -> Settings -> Developer settings.
GITHUB_TOKEN=
# Hugging Face token with write access to the spend-ledger dataset only. huggingface.co -> Settings -> Access Tokens (fine-grained).
HF_TOKEN=
# Private Hugging Face dataset that holds the spend ledger, for example <your-hf-user>/pir-spend-ledger.
SPEND_LEDGER_HF_REPO=
# file (local, before deploy) or hf_dataset (every spender after deploy). Default: file.
SPEND_LEDGER_BACKEND=
